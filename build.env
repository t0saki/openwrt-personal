# Single source of truth for what gets built; read by scripts/build.sh locally
# and in CI. Bump a pin here, nowhere else.

IMMORTALWRT_REPO=https://github.com/immortalwrt/immortalwrt
IMMORTALWRT_REF=v25.12.2

# Default LAN address baked into /bin/config_generate.
LAN_IP=192.168.10.10

# Third-party packages, cloned into package/ as "<dir> <url> <commit>".
# Each one replaces the feed package dirs listed in OVERRIDE_FEED_DIRS.
THIRD_PARTY="
lucky        https://github.com/gdy666/luci-app-lucky.git       91b506627c1d81fa323816e3aeafcbde493d03a9
mosdns       https://github.com/sbwml/luci-app-mosdns.git       dbdd91ab8ac8b079b6a3ca1a48d99e970d17111b
v2ray-geodata https://github.com/sbwml/v2ray-geodata.git        2e3845caae172326f02b3406048c7a3613f3dee5
easytier     https://github.com/EasyTier/luci-app-easytier.git  9c51d3f8d2bfcefd039f2ff2354c6a7674293a06
"
OVERRIDE_FEED_DIRS="
feeds/packages/net/mosdns
feeds/packages/net/v2ray-geodata
"
