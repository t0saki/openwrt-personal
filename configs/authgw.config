# Auth gateway (README "认证网关"): Authelia, nginx with auth_request, realip
# and geo (nginx-full builds every module in; nginx-ssl would need
# CONFIG_NGINX_* lines), acme.sh with its DNS API hooks (Cloudflare dns_cf)
# for DNS-01. All of it ships off: packages/authelia, packages/authgw-nginx
# and DISABLED_SERVICES in build.env. x86_64 only (prebuilt Authelia).
CONFIG_PACKAGE_authelia=y
CONFIG_PACKAGE_authgw-nginx=y
CONFIG_PACKAGE_nginx-full=y
CONFIG_PACKAGE_luci-app-acme=y
# Explicit: uacme provides 'acme' too.
CONFIG_PACKAGE_acme-acmesh=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=y
