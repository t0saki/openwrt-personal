# Docker engine + LuCI for the *_docker profiles, meant for NPM (README
# "认证网关"). dockerman pulls dockerd, docker, docker-compose, containerd,
# runc and tini; dockerd adds kmod-veth/-ipt-nat/-ipt-physdev/-br-netfilter/
# -nf-ipvs as modules, so vermagic differs from the docker-less build of the
# same target. Ships off and router-neutral: DISABLED_SERVICES in build.env,
# patches/0002-*, packages/dockerd-router.
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd-router=y
# Only selects legacy cgroup v1 controllers, 25.12 runs cgroup v2. Left on
# it would change the built-in kernel config, which the lines below pin.
# CONFIG_DOCKER_CGROUP_OPTIONS is not set
# CONFIG_KERNEL_CGROUP_DEVICE is not set
# CONFIG_KERNEL_CGROUP_FREEZER is not set
# CONFIG_KERNEL_NET_CLS_CGROUP is not set
# CONFIG_KERNEL_CGROUP_NET_PRIO is not set
# kmod-macvlan is in every x86 build already; this option only adds
# kmod-dummy, which autoloads and creates a dummy0 interface on every boot.
# CONFIG_DOCKER_NET_MACVLAN is not set
