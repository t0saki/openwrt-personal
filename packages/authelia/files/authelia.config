# Authelia, see README "认证网关". Nothing runs until enabled is 1 and the
# config exists (examples in /usr/share/authelia). Secrets are generated into
# /etc/authelia/secrets on first start; never delete secrets/storage.
config authelia 'main'
	option enabled '0'
	option config '/etc/authelia/configuration.yml'
	# SQLite with passkeys/TOTP, encrypted with secrets/storage. Its
	# directory belongs to authelia, so it must be one of its own. May point
	# into an existing directory on the /mnt disk (not the mount point); it is
	# then not in the sysupgrade backup, so back it up together with
	# /etc/authelia/secrets.
	option storage '/etc/authelia/db/db.sqlite3'
	# Soft Go heap limit. Each password (argon2) login needs 64 MiB on top,
	# passkey logins need none.
	option memlimit '96MiB'
